# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/movielibrary?retryWrites=true&w=majority

# Max Upload Size in Megabytes (e.g. 5120 = 5GB)
MAX_FILE_SIZE_MB=5120

# Cloudflare R2 Object Storage & CDN (Optional - automatically enabled when provided)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=your_r2_bucket_name
# R2_PUBLIC_DOMAIN=pub-xxxxxx.r2.dev

# Authentication & Owner Setup
JWT_SECRET=cinevault_secret_jwt_key_2026_super_secure
OWNER_EMAIL=skfares80@gmail.com
OWNER_USERNAME=owner
OWNER_PASSWORD=Owner@CineVault2026
