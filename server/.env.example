# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/movielibrary

# Max Upload Size in Megabytes (e.g., 5120 = 5GB, 10240 = 10GB)
MAX_FILE_SIZE_MB=5120

# Optional custom upload directories (relative to server directory or absolute)
# POSTER_DIR=uploads/posters
# VIDEO_DIR=uploads/videos
